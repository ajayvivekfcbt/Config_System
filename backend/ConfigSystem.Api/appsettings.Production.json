{
  "ConnectionStrings": {
    "Default": "Server=tcp:${SQL_SERVER_NAME}.database.windows.net,1433;Initial Catalog=ConfigSystem;Persist Security Info=False;User ID=${SQL_USER};Password=${SQL_PASSWORD};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
    "Dev": "Server=tcp:${SQL_SERVER_NAME}.database.windows.net,1433;Initial Catalog=ConfigSystem_Dev;Persist Security Info=False;User ID=${SQL_USER};Password=${SQL_PASSWORD};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
    "Fcb": "Server=tcp:${SQL_SERVER_NAME}.database.windows.net,1433;Initial Catalog=ConfigSystem_Fcb;Persist Security Info=False;User ID=${SQL_USER};Password=${SQL_PASSWORD};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Ibmi": {
    "System": "${IBMI_SYSTEM}",
    "Driver": "IBM i Access ODBC Driver"
  },
  "Fcb400": {
    "System": "${FCB400_SYSTEM}",
    "Library": "${FCB400_LIBRARY}",
    "Uid": "${FCB400_UID}",
    "Pwd": "${FCB400_PWD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Api": {
    "AppKey": "${API_APP_KEY}",
    "AllowedOrigins": [ "${APP_ORIGIN}" ],
    "RateLimit": {
      "PermitLimit": 100,
      "WindowSeconds": 10
    }
  },
  "AllowedHosts": "*"
}
