<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ConfigSystem.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core - SQL Server for production -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <!-- Entity Framework Core - SQLite for local development, seeding, and staging -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Web API -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <!-- AS/400 (IBM i) sign-in validation via the IBM i Access ODBC Driver -->
    <PackageReference Include="System.Data.Odbc" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="data\*.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed GoAnywhere XML data for seeding -->
    <EmbeddedResource Include="data\GoAnywhereProjects.xml" />
  </ItemGroup>

</Project>
