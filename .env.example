# Azure SQL Server Configuration
SQL_SERVER_NAME=configsystem-sql-server
SQL_USER=sqladmin
SQL_PASSWORD=YourSuperSecurePassword123!

# AS/400 (IBM i) Configuration
IBMI_SYSTEM=10.10.1.55

# FCB 400 Configuration
FCB400_SYSTEM=10.10.1.52
FCB400_LIBRARY=UTPRODD
FCB400_UID=your_username
FCB400_PWD=your_password

# Frontend Configuration
VITE_API_URL=http://localhost:5000
# Shared key the web app sends on every API request (must match backend Api:AppKey / API_APP_KEY)
VITE_APP_KEY=config-system-web-app

# Backend API gate
# API_APP_KEY must match the frontend VITE_APP_KEY
API_APP_KEY=config-system-web-app
# Origin the browser app is served from (used for CORS)
APP_ORIGIN=http://localhost:5000

